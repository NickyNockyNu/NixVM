<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{E41DCAD2-070C-4E0B-8B04-ABB1E16F0EE4}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="nvmc.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="nvmd.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="nvmtest.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="nvma.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="nvmc">
        <MSBuild Projects="nvmc.dproj"/>
    </Target>
    <Target Name="nvmc:Clean">
        <MSBuild Projects="nvmc.dproj" Targets="Clean"/>
    </Target>
    <Target Name="nvmc:Make">
        <MSBuild Projects="nvmc.dproj" Targets="Make"/>
    </Target>
    <Target Name="nvmd">
        <MSBuild Projects="nvmd.dproj"/>
    </Target>
    <Target Name="nvmd:Clean">
        <MSBuild Projects="nvmd.dproj" Targets="Clean"/>
    </Target>
    <Target Name="nvmd:Make">
        <MSBuild Projects="nvmd.dproj" Targets="Make"/>
    </Target>
    <Target Name="nvmtest">
        <MSBuild Projects="nvmtest.dproj"/>
    </Target>
    <Target Name="nvmtest:Clean">
        <MSBuild Projects="nvmtest.dproj" Targets="Clean"/>
    </Target>
    <Target Name="nvmtest:Make">
        <MSBuild Projects="nvmtest.dproj" Targets="Make"/>
    </Target>
    <Target Name="nvma">
        <MSBuild Projects="nvma.dproj"/>
    </Target>
    <Target Name="nvma:Clean">
