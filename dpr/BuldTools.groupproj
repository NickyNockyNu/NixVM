    </Target>
    <Target Name="Build">
        <CallTarget Targets="nvmc;nvmd;nvmtest;nvma"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="nvmc:Clean;nvmd:Clean;nvmtest:Clean;nvma:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="nvmc:Make;nvmd:Make;nvmtest:Make;nvma:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
